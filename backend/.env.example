# Local server port. Render supplies PORT in its environment.
PORT=8000
# Set this on the backend only; these are placeholders, not real credentials.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# For Neon, the backend enforces sslmode=verify-full and defaults sslrootcert=system.
# Optional Development target lock (use the exact hostname from Neon, no credentials).
# ENSOUND_DEV_DATABASE_HOST=YOUR-ENDPOINT.YOUR-REGION.aws.neon.tech
# ENSOUND_DEV_DATABASE_NAME=neondb
# Optional UTC-aware ISO 8601 timestamps. Set both exactly seven days apart to enable NT$99.
# LAUNCH_PROMO_START_AT=YYYY-MM-DDTHH:MM:SS+00:00
# LAUNCH_PROMO_END_AT=YYYY-MM-DDTHH:MM:SS+00:00
# Verification email configuration; set privately in the backend environment.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Email Claim/release rate-limit HMAC key: inject a private random value (at least 32 bytes).
CLAIM_RATE_LIMIT_KEY=
# Optional approved Development frontend handoff; unset disables the handoff.
# ENSOUND_DEV_FRONTEND_URL=http://localhost:5173/EnSound-UP-dev/
# Local Development example; the link must be opened on the same machine as this backend.
EMAIL_VERIFY_BASE_URL=http://127.0.0.1:8000
# ECPay All-in-One STAGE only; put real Development credentials in backend secrets.
ECPAY_STAGE_MERCHANT_ID=
ECPAY_STAGE_HASH_KEY=
ECPAY_STAGE_HASH_IV=
# Public HTTPS backend notification URL; callback handling is a later checkpoint.
ECPAY_STAGE_RETURN_URL=
